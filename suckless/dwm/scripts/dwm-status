#!/usr/bin/env python3
"""Compact, live X11 status line for the charcoal dwm bar."""
from datetime import datetime
import json
import os
from pathlib import Path
import subprocess
import sys
import threading
import time
from urllib.request import urlopen


class Network:
    """Sample bytes on the default route; reset on an interface change."""
    def __init__(self):
        self.previous = None
        self.text()

    def interface(self):
        try:
            routes = [line.split() for line in Path('/proc/net/route').read_text().splitlines()[1:]]
            defaults = [row for row in routes if row[1] == '00000000' and int(row[3], 16) & 1]
            if defaults:
                return min(defaults, key=lambda row: int(row[6]))[0]
        except (OSError, ValueError, IndexError):
            pass
        for device in sorted(Path('/sys/class/net').iterdir()):
            try:
                if device.name != 'lo' and device.joinpath('operstate').read_text().strip() == 'up':
                    return device.name
            except OSError:
                continue
        return None

    @staticmethod
    def rate(value):
        if value >= 1048576:
            return f'{value / 1048576:.1f}M/s'
        if value >= 1024:
            return f'{value / 1024:.0f}K/s'
        return f'{value:.0f}B/s'

    def text(self):
        iface = self.interface()
        try:
            stats = Path('/sys/class/net') / iface / 'statistics'
            rx = int(stats.joinpath('rx_bytes').read_text())
            tx = int(stats.joinpath('tx_bytes').read_text())
        except (OSError, ValueError, TypeError):
            self.previous = None
            return '↓ -- ↑ --'
        now = time.monotonic()
        down = up = 0
        if self.previous and self.previous[0] == iface:
            elapsed = max(now - self.previous[3], 0.001)
            down = max(rx - self.previous[1], 0) / elapsed
            up = max(tx - self.previous[2], 0) / elapsed
        self.previous = (iface, rx, tx, now)
        return f'↓ {self.rate(down)} ↑ {self.rate(up)}'


class Weather:
    """Refresh Dhaka weather in the background, with bounded network waits."""
    url = ('https://api.open-meteo.com/v1/forecast?latitude=23.8103&longitude=90.4125'
           '&current=temperature_2m,weather_code,is_day&temperature_unit=celsius'
           '&timezone=Asia%2FDhaka&forecast_days=1')

    def __init__(self):
        self.label = '\uf0c2 --°C'
        self.updated = 0
        threading.Thread(target=self.refresh, daemon=True).start()

    def refresh(self):
        while True:
            delay = 900
            try:
                with urlopen(self.url, timeout=8) as response:
                    current = json.load(response)['current']
                code = int(current['weather_code'])
                temp = float(current['temperature_2m'])
                if code == 0:
                    icon = '\uf185' if current.get('is_day') else '\uf186'
                elif code in (1, 2, 3):
                    icon = '\uf0c2'
                elif code in (45, 48):
                    icon = '\uf75f'
                elif code in (71, 73, 75, 77, 85, 86):
                    icon = '\uf2dc'
                elif code >= 95:
                    icon = '\uf0e7'
                else:
                    icon = '\uf73d'
                self.label = f'{icon} {temp:.0f}°C'
                self.updated = time.monotonic()
            except (OSError, ValueError, KeyError, TypeError) as error:
                print(f'Dhaka weather refresh failed: {error}', file=sys.stderr, flush=True)
                delay = 300
            time.sleep(delay)

    def text(self):
        if self.updated and time.monotonic() - self.updated < 3600:
            return self.label
        return '\uf0c2 --°C'


def command(*args):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=2)
        return result.stdout.strip() if result.returncode == 0 else ''
    except (OSError, subprocess.TimeoutExpired):
        return ''


def cpu_sample():
    values = [int(v) for v in Path('/proc/stat').read_text().splitlines()[0].split()[1:9]]
    return sum(values), values[3] + values[4]


def temperature():
    for sensor in Path('/sys/class/hwmon').glob('hwmon*'):
        try:
            if (sensor / 'name').read_text().strip() not in ('k10temp', 'coretemp'):
                continue
            for entry in sorted(sensor.glob('temp*_input')):
                return f'{int(entry.read_text()) // 1000}°C'
        except (OSError, ValueError):
            continue
    return '--°C'


def memory():
    values = {}
    for line in Path('/proc/meminfo').read_text().splitlines():
        fields = line.split()
        values[fields[0].rstrip(':')] = int(fields[1])
    return f"{(values['MemTotal'] - values['MemAvailable']) / 1048576:.2f}g"


def recording():
    for process in Path('/proc').iterdir():
        if not process.name.isdigit():
            continue
        try:
            args = process.joinpath('cmdline').read_bytes().split(b'\0')
            name = Path(os.fsdecode(args[0])).name
            if name in ('wf-recorder', 'gpu-screen-recorder') or (
                name == 'ffmpeg' and any(v in args for v in (b'x11grab', b'kmsgrab'))
            ):
                return 'Rec ●'
        except (OSError, IndexError):
            continue
    return 'Rec ·'


def music():
    state = command('playerctl', 'status')
    if state not in ('Playing', 'Paused'):
        return '\uf001 No music'
    title = command('playerctl', 'metadata', '--format', '{{artist}} - {{title}}')
    title = ' '.join(title.split()).strip(' -') or 'Unknown track'
    if len(title) > 36:
        title = title[:35] + '…'
    return f"{'\uf04c' if state == 'Paused' else '\uf04b'} {title}"


def volume():
    output = command('wpctl', 'get-volume', '@DEFAULT_AUDIO_SINK@')
    if not output:
        return ''
    if '[MUTED]' in output:
        return '\uf6a9 muted'
    try:
        return f'\uf028 {float(output.split()[1]) * 100:.0f}%'
    except (ValueError, IndexError):
        return ''


def battery():
    for device in Path('/sys/class/power_supply').glob('BAT*'):
        try:
            return f"\uf240 {device.joinpath('capacity').read_text().strip()}%"
        except OSError:
            continue
    return ''


def status(previous, current, weather, network):
    total = current[0] - previous[0]
    idle = current[1] - previous[1]
    usage = round(100 * (total - idle) / total) if total > 0 else 0
    now = datetime.now()
    parts = [recording(), f'\uf2db {temperature()}  \uefc5 {memory()}',
             f'\uf303 {usage}%', network.text(), music(), battery(), volume(), weather.text(),
             now.strftime('%A, %b ') + str(now.day) + '  ' + now.strftime('%I:%M%p').lstrip('0').lower()]
    return '  ' + ' | '.join(part for part in parts if part) + '  '


def main():
    weather = Weather()
    network = Network()
    previous = cpu_sample()
    time.sleep(0.2 if '--once' in sys.argv else 1)
    while True:
        current = cpu_sample()
        text = status(previous, current, weather, network)
        previous = current
        if '--once' in sys.argv:
            print(text)
            return
        if subprocess.run(['xsetroot', '-name', text], capture_output=True).returncode:
            return
        time.sleep(3)


if __name__ == '__main__':
    main()
